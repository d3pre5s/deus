CODE_SIGN_IDENTITY[sdk=macosx*] = Apple Development
AIRLOCK_SIGN_SFM_System = Configuration/Qualification/Host.entitlements
AIRLOCK_SIGN_SystemExtension = Configuration/Qualification/Tunnel.entitlements
