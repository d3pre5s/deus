#!/usr/bin/python3 -I
"""Start the vendor CLI inside an inherited, loopback-only network policy."""
import json
import os
from pathlib import Path
import sys
from urllib.parse import quote

root = Path(__file__).resolve().parents[1]
config = json.loads((root / "client.json").read_text())
port = config["port"]
if type(port) is not int or not 1 <= port <= 65535:
    sys.exit("Invalid Airlock proxy port")
vendor = Path.home() / ".local/bin/claude"
if vendor.resolve() == Path(__file__).resolve():
    sys.exit("Expected the vendor Claude CLI at ~/.local/bin/claude")
proxy = "https://airlock:{}@127.0.0.1:{}".format(quote(config["password"], safe=""), port)
env = os.environ.copy()
# OpenSSH Match exec accepts an unset SHELL, but rejects an empty path.
if env.get("SHELL") == "":
    del env["SHELL"]
for key in ("http_proxy", "https_proxy", "all_proxy"):
    env[key] = env[key.upper()] = proxy
env["NO_PROXY"] = env["no_proxy"] = ""
env.update(
    AIRLOCK_CLI_ACTIVE="1",
    AIRLOCK_SSH_CONNECT=str(root / "ssh-connect"),
    CURL_HOME=str(root),
    GIT_PROXY_SSL_CAINFO=str(root / "proxy.crt"),
    NODE_EXTRA_CA_CERTS=str(root / "proxy.crt"),
    PATH=str(root / "helpers") + os.pathsep + env["PATH"],
)
# Deny new sockets by default. Command-line flags and children that clear their
# environment still have to satisfy the inherited kernel policy.
profile = f'''(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote tcp "localhost:{port}"))
(deny mach-lookup (global-name "com.apple.dnssd.service"))
(deny file-write* (subpath (param "AIRLOCK_ROOT")))
(deny file-read* (literal (param "AIRLOCK_PROVIDER")))
'''
os.execve("/usr/bin/sandbox-exec", [
    "sandbox-exec", "-D", f"AIRLOCK_ROOT={root}", "-D", f"AIRLOCK_PROVIDER={root / 'provider.json'}",
    "-p", profile, str(vendor), *sys.argv[1:],
], env)
